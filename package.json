{
  "name": "rt-author-desk",
  "productName": "RT Author Desk",
  "version": "1.1.0",
  "description": "The business side of being an author, on your own computer, for Windows, macOS and Linux.",
  "author": "Recon Towers Dev Department <author@neogentrics.com>",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "main": "src/main/main.js",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "electron-updater": "^6.8.11",
    "fast-xml-parser": "^5.12.0",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.cjs\"",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --arm64 --x64 --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --x64 --publish never",
    "check:install": "node scripts/check-install.cjs",
    "icons": "electron scripts/make-icons.cjs",
    "test:e2e": "node --test test/e2e.test.cjs",
    "screenshots": "node scripts/screenshots.cjs",
    "test:packaged": "node --test test/packaged.test.cjs",
    "notices": "node scripts/make-notices.cjs"
  },
  "build": {
    "appId": "com.recontowers.authordesk",
    "productName": "RT Author Desk",
    "npmRebuild": false,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/main/**",
      "src/shared/**",
      "src/renderer/**",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "!node_modules/node-addon-api/**",
      "!node_modules/better-sqlite3-multiple-ciphers/deps/**",
      "!node_modules/better-sqlite3-multiple-ciphers/src/**",
      "!node_modules/better-sqlite3-multiple-ciphers/binding.gyp"
    ],
    "copyright": "Copyright © 2026 Recon Towers. All rights reserved.",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "files": [
        "src/main/**",
        "src/shared/**",
        "src/renderer/**",
        "package.json",
        "LICENSE",
        "THIRD_PARTY_NOTICES.md",
        "!node_modules/better-sqlite3-multiple-ciphers/prebuilds/darwin-*",
        "!node_modules/better-sqlite3-multiple-ciphers/prebuilds/linux*",
        "!node_modules/better-sqlite3-multiple-ciphers/prebuilds/win32-arm64.node"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RT Author Desk",
      "license": "LICENSE",
      "artifactName": "RTAuthorDesk-${version}-Setup.exe",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "RTAuthorDesk-${version}-Portable.exe"
    },
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "files": [
        "src/main/**",
        "src/shared/**",
        "src/renderer/**",
        "package.json",
        "LICENSE",
        "THIRD_PARTY_NOTICES.md",
        "!node_modules/better-sqlite3-multiple-ciphers/prebuilds/win32-*",
        "!node_modules/better-sqlite3-multiple-ciphers/prebuilds/linux*"
      ]
    },
    "dmg": {
      "artifactName": "RTAuthorDesk-${version}-mac-${arch}.dmg"
    },
    "linux": {
      "category": "Office",
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "RTAuthorDesk-${version}-linux-${arch}.${ext}",
      "maintainer": "Recon Towers Dev Department <author@neogentrics.com>",
      "synopsis": "The business side of being an author",
      "files": [
        "src/main/**",
        "src/shared/**",
        "src/renderer/**",
        "package.json",
        "LICENSE",
        "THIRD_PARTY_NOTICES.md",
        "!node_modules/better-sqlite3-multiple-ciphers/prebuilds/win32-*",
        "!node_modules/better-sqlite3-multiple-ciphers/prebuilds/darwin-*",
        "!node_modules/better-sqlite3-multiple-ciphers/prebuilds/linux*arm64.node"
      ]
    },
    "deb": {
      "packageCategory": "office"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "neogentrics",
        "repo": "rt-author-desk",
        "releaseType": "release",
        "channel": "latest"
      }
    ]
  },
  "homepage": "https://github.com/neogentrics/rt-author-desk",
  "bugs": "https://github.com/neogentrics/rt-author-desk/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/neogentrics/rt-author-desk.git"
  }
}
